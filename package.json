{
  "name": "multi-model-compare",
  "displayName": "多模型对比对话",
  "description": "在独立面板里把同一个问题同时发给多个大模型，流式对比它们的回答，支持多轮追问、图片输入与本地历史。",
  "version": "0.9.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "multiModelCompare.open",
        "title": "打开对比对话面板",
        "category": "多模型对比"
      },
      {
        "command": "multiModelCompare.newSession",
        "title": "新建会话",
        "category": "多模型对比"
      },
      {
        "command": "multiModelCompare.toggleHistory",
        "title": "显示 / 隐藏历史会话",
        "category": "多模型对比"
      }
    ],
    "configuration": {
      "title": "多模型对比对话",
      "properties": {
        "multiModelCompare.preferredVendors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "customendpoint"
          ],
          "markdownDescription": "默认只显示这些来源（vendor）下的模型。默认值 `customendpoint` 就是你自己在 `chatLanguageModels.json` 里添加的模型。留空数组表示不按来源过滤。"
        },
        "multiModelCompare.onlyPreferredVendors": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "只显示 `multiModelCompare.preferredVendors` 白名单里的模型（默认＝你自己添加的那几个）。关闭后列出全部可用模型，包括 Copilot 自带的。"
        },
        "multiModelCompare.maxSelectedModels": {
          "type": "number",
          "default": 8,
          "markdownDescription": "默认勾选参与提问的模型数量上限，防止一次提问并发打到过多模型（费用 / 速率限制）。设为 `0` 表示不限制。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b --watch",
    "pretest": "npm run compile",
    "test": "node scripts/smoke-render.mjs && node scripts/unit-test.mjs",
    "install:local": "npm run compile && node scripts/install-local.mjs",
    "uninstall:local": "node scripts/install-local.mjs --uninstall",
    "package:vsix": "npm run compile && node scripts/package-vsix.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.137.0",
    "typescript": "^5.0.0"
  }
}
